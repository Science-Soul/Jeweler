      m_Calls: []
  m_text: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u043F\u043E\u043D\u044F\u043B,
    \u0432 \u0447\u0435\u043C \u0434\u0435\u043B\u043E! \u0412 \u043F\u0440\u043E\u0448\u043B\u044B\u0439
    \u0440\u0430\u0437 \u043E\u043D\u0438 \u0441\u0432\u0435\u0442\u0438\u043B\u0438\u0441\u044C,
    \u043A\u043E\u0433\u0434\u0430 \u044F \u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u043D\u0430 \u0441\u0432\u043E\u0435\u0439 \u043D\u0430\u043A\u043E\u0432\u0430\u043B\u044C\u043D\u0435.
    \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u044D\u0442\u043E \u0438\u043C\u0435\u0435\u0442
    \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435. \u0421\u0442\u043E\u0438\u0442
    \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C."
