    - target: {fileID: 929258343922350797, guid: a5c33638ff38c0d4ab8820002bc0f21b, type: 3}
      propertyPath: m_text
      value: "\u0414\u0430\u0439-\u043A\u0430 \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u0442\u044C.
        \u0425\u043C... \u041F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u043A\u0430\u043A\u0443\u044E-\u0442\u043E
        \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043A\u0443. \u041A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0432 \u044D\u0442\u0438 \u0432\u044B\u0435\u043C\u043A\u0438 \u043D\u0443\u0436\u043D\u043E
        \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u0430\u043C\u043D\u0438
        \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445
        \u0446\u0432\u0435\u0442\u043E\u0432. \u0410 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435
        \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u0442\u043E\u044F\u0442\u044C
        \u0440\u0430\u0434\u0443\u0436\u043D\u044B\u0439 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B.
        \u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E
        \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432\u0441\u0435
        \u043F\u043E \u043C\u0435\u0441\u0442\u0430\u043C!"
      objectReference: {fileID: 0}
