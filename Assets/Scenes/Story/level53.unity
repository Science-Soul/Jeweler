  m_text: "\u042F \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E \u0432\u0430\u0441
    \u043E\u0442 \u0438\u043C\u0435\u043D\u0438 \u0432\u0441\u0435\u0433\u043E \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430!
