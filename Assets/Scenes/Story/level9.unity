      objectReference: {fileID: 0}
    - target: {fileID: 2625495729963606321, guid: bc6070cc56a2a864e91a1aef3a0ecbee, type: 3}
      propertyPath: m_text
      value: "\u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C
        \u0431\u044B\u043B\u043E \u0431\u044B \u043D\u0435 \u0441\u043B\u043E\u0436\u043D\u043E,
        \u043D\u043E \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F
        \u043E\u0441\u043E\u0431\u044B\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B.
        \u042D\u0442\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
        \u043F\u0438\u0442\u0430\u044E\u0442\u0441\u044F \u043C\u0430\u0433\u0438\u0435\u0439
        \u0441\u0432\u0435\u0442\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
        \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0435\u0441\u044F
        \u043A\u0430\u043C\u043D\u0438. \u041D\u0430\u0439\u0434\u0438 \u0438\u0437\u0443\u043C\u0440\u0443\u0434,
        \u0442\u043E\u043F\u0430\u0437 \u0438 \u0430\u043C\u0435\u0442\u0438\u0441\u0442.
        \u041E\u043D\u0438 \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C
        \u0437\u0430\u0440\u044F\u0436\u0435\u043D\u044B \u043C\u0430\u0433\u0438\u0435\u0439
        \u0441\u0432\u0435\u0442\u0430, \u0438\u043D\u0430\u0447\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
        \u043D\u0435 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442.
        \u042F \u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E \u043D\u0435 \u0432\u0438\u0434\u0435\u043B
        \u0442\u0430\u043A\u0438\u0445 \u043A\u0430\u043C\u043D\u0435\u0439..."
      objectReference: {fileID: 0}
