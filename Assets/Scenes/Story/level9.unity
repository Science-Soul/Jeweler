    - target: {fileID: 2625495729963606321, guid: bc6070cc56a2a864e91a1aef3a0ecbee, type: 3}
      propertyPath: m_text
      value: "\u0420\u0430\u0431\u043E\u0442\u0430 \u0441 \u043A\u0430\u043C\u043D\u044F\u043C\u0438
        \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043E\u0447\u0435\u043D\u044C
        \u0432\u044B\u0441\u043E\u043A\u0438\u0445 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
        \u0434\u043E\u0441\u0442\u0438\u0447\u044C \u0432 \u043F\u0440\u043E\u0441\u0442\u043E\u043C
        \u043A\u0443\u0437\u043D\u0435\u0447\u043D\u043E\u043C \u0433\u043E\u0440\u043D\u0435.
        \u0417\u0434\u0435\u0441\u044C \u043D\u0443\u0436\u043D\u0430 \u043C\u0430\u0433\u0438\u044F
        \u0441\u0432\u0435\u0442\u0430. \u0422\u044B \u0432\u0440\u043E\u0434\u0435
        \u043A\u0430\u043A \u0443\u043C\u0435\u0435\u0448\u044C \u0435\u0449\u0435
        \u0437\u0430\u0440\u044F\u0436\u0430\u0442\u044C \u043A\u0430\u043C\u043D\u0438
        \u0441\u0432\u0435\u0442\u043E\u043C? \u041C\u043E\u0436\u0435\u0442, \u044D\u0442\u043E\u0442
        \u0442\u0440\u044E\u043A \u0438 \u0441 \u0433\u043E\u0440\u043D\u043E\u043C
        \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442?"
      objectReference: {fileID: 0}
