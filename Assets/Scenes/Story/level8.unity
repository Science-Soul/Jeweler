    - target: {fileID: 1308481226765700760, guid: 04f64a9ba764bb94caf553bf83cc23fe, type: 3}
      propertyPath: m_text
      value: "\u0414\u0430. \u041E\u043D \u043E\u0441\u0442\u0430\u0432\u0438\u043B
        \u043C\u043D\u0435 \u0441\u0432\u043E\u044E \u043D\u0430\u043A\u043E\u0432\u0430\u043B\u044C\u043D\u044E,
        \u0438 \u044F \u0443\u0436\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u043E\u0441\u0432\u043E\u0438\u043B \u0435\u0435 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430. \u0410 \u0432\u043E\u0442
        \u043D\u0430\u0441\u0447\u0435\u0442 \u0434\u0440\u0443\u0433\u0438\u0445
        \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432...
        \u042F \u043D\u0435 \u043F\u043E\u043D\u044F\u043B, \u043A\u0430\u043A \u043E\u043D\u0438
        \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
        \u043E\u043D\u0438 \u0441\u043B\u043E\u043C\u0430\u043D\u044B. \u041D\u0443\u0436\u043D\u043E
        \u043F\u043E\u0441\u043E\u0432\u0435\u0442\u043E\u0432\u0430\u0442\u044C\u0441\u044F
        \u0441 \u043A\u0443\u0437\u043D\u0435\u0446\u043E\u043C."
      objectReference: {fileID: 0}
