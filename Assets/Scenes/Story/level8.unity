    - target: {fileID: 677900714633419615, guid: 333adcc5ef2d4584980b2fc5a9b87f03, type: 3}
      propertyPath: m_text
      value: "\u041E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E!
        \u041C\u044B \u043F\u043E\u0434\u043D\u044F\u043B\u0438 \u0441\u0442\u0430\u0440\u044B\u0435
        \u043B\u0435\u0442\u043E\u043F\u0438\u0441\u0438 \u0438 \u0432\u044B\u044F\u0441\u043D\u0438\u043B\u0438,
        \u0447\u0442\u043E \u0432\u0430\u0448 \u0443\u0447\u0438\u0442\u0435\u043B\u044C
        \u0431\u044B\u043B \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u041A\u0443\u0437\u043D\u0435\u0446\u043E\u0432
        \u0441\u0432\u0435\u0442\u0430. \u042D\u0442\u043E \u0434\u0440\u0435\u0432\u043D\u044F\u044F
        \u0433\u0438\u043B\u044C\u0434\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
        \u0431\u044B\u043B\u0430 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0430
        \u0441 \u0446\u0435\u043B\u044C\u044E \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
        \u043D\u0435\u043A\u0438\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442,
        \u043F\u0438\u0442\u0430\u0432\u0448\u0438\u0439 \u0441\u0432\u0435\u0442
        \u043C\u0430\u0433\u0438\u0435\u0439. \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
        \u0433\u0438\u043B\u044C\u0434\u0438\u044F \u0440\u0430\u0441\u043F\u0430\u043B\u0430\u0441\u044C
        \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u0432\u0435\u043A\u0435,
        \u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u0432 \u0436\u0438\u0432\u044B\u0445
        \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0438
        \u043E\u0434\u043D\u043E\u0433\u043E \u0435\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044F."
      objectReference: {fileID: 0}
