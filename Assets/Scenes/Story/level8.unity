      propertyPath: m_text
      value: "\u041E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E!
        \u0418 \u0432\u043E\u0442 \u0435\u0449\u0435. \u041E \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u0438
