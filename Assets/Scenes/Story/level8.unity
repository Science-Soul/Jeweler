--- !u!1001 &371707398743242334
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 91298524}
    m_Modifications:
    - target: {fileID: 677900714633419614, guid: 333adcc5ef2d4584980b2fc5a9b87f03, type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -254
      objectReference: {fileID: 0}
    - target: {fileID: 677900714633419615, guid: 333adcc5ef2d4584980b2fc5a9b87f03, type: 3}
      propertyPath: m_text
      value: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
        \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D \u041B\u0435\u043E\u0440\u0430\u043D!
        \u042F \u043F\u0440\u0438\u0431\u044B\u043B \u043F\u043E \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044E
        \u0415\u0433\u043E \u0412\u0435\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
        \u043A\u043E\u0440\u043E\u043B\u044F \u0412\u0438\u043B\u044C\u0433\u0435\u043B\u044C\u043C\u0430.
        \u041A\u0430\u043A \u0432\u0430\u043C \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
        \u043D\u0430\u0448\u0438 \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u044B\u0435
        \u043A\u0430\u043C\u043D\u0438 \u043D\u0430\u0447\u0430\u043B\u0438 \u0442\u0443\u0441\u043A\u043D\u0435\u0442\u044C.
        \u0421\u0432\u0435\u0442 \u0441\u0442\u0430\u043B \u0442\u0435\u0440\u044F\u0442\u044C
        \u0441\u0432\u043E\u0438 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430, \u0438 \u044D\u0442\u043E
        \u0443\u0436\u0435 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u0441\u0432\u043E\u0438
        \u043F\u043B\u043E\u0434\u044B. \u041D\u0430\u0448\u0438 \u043C\u0430\u0448\u0438\u043D\u044B
        \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C,
        \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043C\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u043C
        \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0443\u0440\u043E\u0436\u0430\u0439
        \u0442\u0430\u043A \u0436\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E,
        \u043A\u0430\u043A \u0440\u0430\u043D\u044C\u0448\u0435. \u0412\u0440\u0430\u0447\u0430\u043C
