    - target: {fileID: 1308481226765700760, guid: 04f64a9ba764bb94caf553bf83cc23fe, type: 3}
      propertyPath: m_text
      value: "\u0412\u043E\u0442 \u044D\u0442\u043E \u0434\u0430... \u042F-\u0442\u043E
        \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u044F \u043E\u0431\u044B\u0447\u043D\u044B\u0439
        \u044E\u0432\u0435\u043B\u0438\u0440, \u043F\u0440\u043E\u0441\u0442\u043E
        \u0440\u0435\u043C\u0435\u0441\u043B\u0435\u043D\u043D\u0438\u043A, \u0434\u0435\u043B\u0430\u044E\u0449\u0438\u0439
        \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u044F \u043D\u0430 \u0437\u0430\u043A\u0430\u0437...
        \u0418 \u0432\u0441\u0435-\u0442\u0430\u043A\u0438. \u0427\u0442\u043E \u044F
        \u043C\u043E\u0433\u0443 \u0441\u0434\u0435\u043B\u0430\u0442\u044C? \u042F
        \u0434\u0430\u0436\u0435 \u043F\u043E\u043D\u044F\u0442\u0438\u044F \u043D\u0435
        \u0438\u043C\u0435\u044E \u043D\u0438 \u043E \u043A\u0430\u043A\u043E\u043C
        \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0435."
      objectReference: {fileID: 0}
