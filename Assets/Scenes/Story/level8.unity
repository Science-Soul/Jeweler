    - target: {fileID: 677900714633419615, guid: 333adcc5ef2d4584980b2fc5a9b87f03, type: 3}
      propertyPath: m_text
      value: "\u0421\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u0432\u0435\u0440\u043D\u043E!
        \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043A\u043E\u0440\u043E\u043B\u044C
        \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B \u043C\u0435\u043D\u044F
        \u043A \u0432\u0430\u043C. \u041E\u043D \u043F\u0440\u043E\u0441\u0438\u0442
        \u0432\u0430\u0441 \u043F\u043E\u043C\u043E\u0447\u044C \u043D\u0430\u0439\u0442\u0438
        \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442 \u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
        \u0435\u0433\u043E. \u0413\u043E\u0441\u043F\u043E\u0434\u0438\u043D \u0410\u0440\u043C\u0430\u043D\u0434
        \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u043D\u0430\u0443\u0447\u0438\u043B
        \u0432\u0430\u0441 \u0432\u0441\u0435\u043C\u0443 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u043C\u0443,
        \u0445\u043E\u0442\u044C \u0438 \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B
        \u0432\u0430\u043C \u0432 \u044F\u0432\u043D\u043E\u043C \u0432\u0438\u0434\u0435,
        \u0434\u043B\u044F \u0447\u0435\u0433\u043E \u043D\u0430 \u0441\u0430\u043C\u043E\u043C
        \u0434\u0435\u043B\u0435 \u044D\u0442\u043E \u043D\u0443\u0436\u043D\u043E."
