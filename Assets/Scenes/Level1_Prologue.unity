--- !u!1001 &873357684
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 552670844}
    m_Modifications:
    - target: {fileID: 5846215786271189016, guid: 29a2c1bd66fa6914eb9f0aa415c04c84, type: 3}
      propertyPath: m_text
      value: "\u041E\u0434\u043D\u0430\u043A\u043E \u0441\u0438\u043B\u044B \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430
        \u043D\u0435 \u0431\u044B\u043B\u0438 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u043C\u0438.
        \u0412\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0435 \u0443\u043C\u044B
        \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430
        \u043F\u043E\u043D\u044F\u043B\u0438, \u0447\u0442\u043E \u0434\u043B\u044F
        \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F \u0431\u0430\u043B\u0430\u043D\u0441\u0430
        \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
        \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u0440\u0438\u0442\u0443\u0430\u043B\u044B. \u041E\u043D\u0438 \u043E\u0441\u043D\u043E\u0432\u0430\u043B\u0438
        \u0433\u0438\u043B\u044C\u0434\u0438\u044E \u041A\u0443\u0437\u043D\u0435\u0446\u043E\u0432
        \u0441\u0432\u0435\u0442\u0430, \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0443\u044E\u0441\u044F
        \u043D\u0430 \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0438 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430
        \u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0438
        \u0435\u0433\u043E \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
        \u0441\u0432\u043E\u0439\u0441\u0442\u0432. \u0410\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0443
        \u0431\u044B\u043B\u043E \u0434\u0430\u043D\u043E <align=center>\u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
        - \u042D\u0433\u0438\u0434\u0430 \u0432\u0435\u0447\u043D\u043E\u0433\u043E
        \u0441\u0438\u044F\u043D\u0438\u044F.\r</align>\n"
      objectReference: {fileID: 0}
