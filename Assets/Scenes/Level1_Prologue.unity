--- !u!1001 &2030008708240898896
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 5933078777642156459}
    m_Modifications:
    - target: {fileID: 5846215786271189016, guid: 29a2c1bd66fa6914eb9f0aa415c04c84, type: 3}
      propertyPath: m_text
      value: "\u0421\u043F\u0443\u0441\u0442\u044F \u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434\u044B
        \u043B\u0435\u0442 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442 \u0431\u044B\u043B
        \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D \u043B\u044E\u0434\u044C\u043C\u0438.
        \u0421 \u0435\u0433\u043E \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043E\u043D\u0438
        \u043D\u0430\u0443\u0447\u0438\u043B\u0438\u0441\u044C \u043D\u0430\u0434\u0435\u043B\u044F\u0442\u044C
        \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438
        \u0432\u0441\u0435 \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u044B\u0435
        \u043A\u0430\u043C\u043D\u0438 \u043C\u0438\u0440\u0430. \u042D\u0442\u043E
        \u0431\u044B\u043B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
        \u043F\u0440\u043E\u0440\u044B\u0432 - \u0442\u0435\u043F\u0435\u0440\u044C
        \u043B\u044E\u0434\u0438 \u043C\u043E\u0433\u043B\u0438 \u043B\u0435\u0433\u043A\u043E
        \u0438\u0441\u0446\u0435\u043B\u044F\u0442\u044C \u0441\u0432\u043E\u0438
        \u043D\u0435\u0434\u0443\u0433\u0438, \u0440\u0430\u0441\u0442\u0438\u0442\u044C
        \u0445\u043B\u0435\u0431 \u043D\u0430 \u043F\u043E\u043B\u044F\u0445, \u0441\u043E\u0433\u0440\u0435\u0432\u0430\u0442\u044C\u0441\u044F
        \u0437\u0438\u043C\u043E\u0439, \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442\u044C
        \u0432 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435   \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435
        \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B \u0438 \u043C\u0430\u0448\u0438\u043D\u044B..."
