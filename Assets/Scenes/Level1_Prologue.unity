    m_Modifications:
    - target: {fileID: 5846215786271189016, guid: 29a2c1bd66fa6914eb9f0aa415c04c84, type: 3}
      propertyPath: m_text
      value: "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u0432 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
        \u0441\u043B\u0443\u0447\u0438\u043B\u0441\u044F \u0440\u0430\u0437\u0434\u043E\u0440.
        \u041A\u0443\u0437\u043D\u0435\u0446\u044B \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0438
        \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
        \u043E \u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u043C
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
        \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430. \u0420\u0430\u0437\u0440\u043E\u0437\u043D\u0435\u043D\u043D\u0430\u044F
        \u0433\u0438\u043B\u044C\u0434\u0438\u044F \u0431\u043E\u043B\u044C\u0448\u0435
        \u043D\u0435 \u043C\u043E\u0433\u043B\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
        \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442. \u041F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
        \u042D\u0433\u0438\u0434\u0430 \u043D\u0430\u0447\u0430\u043B\u0430 \u0443\u0433\u0430\u0441\u0430\u0442\u044C.
        \u0421\u0432\u0435\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0441\u0432\u043E\u0438
        <align=center>\u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430. \u041C\u0438\u0440 \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u043B\u0441\u044F
        \u0432 \u0443\u043D\u044B\u043B\u0443\u044E \u0441\u0435\u0440\u043E\u0441\u0442\u044C...</align>"
      objectReference: {fileID: 0}
