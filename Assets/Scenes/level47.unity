        \u0441\u043A\u0430\u0437\u0430\u043D\u043E, \u0447\u0442\u043E \u0434\u043B\u044F
        \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438 \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E
        \u0441\u0430\u043F\u0444\u0438\u0440\u0430 \u043F\u0440\u043E\u0441\u0442\u044B\u0445
        \u043A\u0430\u043C\u043D\u0435\u0439 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.
        \u041D\u0443\u0436\u0435\u043D \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439
        \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
        \u043F\u0435\u0440\u0435\u0434\u0430\u0435\u0442\u0441\u044F \u043C\u0435\u0436\u0434\u0443
        \u0447\u043B\u0435\u043D\u0430\u043C\u0438 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
        \u0438\u0437 \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F \u0432
        \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u0435. \u0417\u0434\u0435\u0441\u044C
        \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043D\u043E, \u0433\u0434\u0435
        \u0435\u0433\u043E \u0438\u0441\u043A\u0430\u0442\u044C."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 5975f509e99e36a409053fddb39795f5, type: 3}
