  m_text: "\u0418\u0437 \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F \u0432
    \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u0435? \u0425\u043C... \u041C\u043D\u0435
    \u0432 \u0433\u043E\u043B\u043E\u0432\u0443 \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E
    \u043F\u0440\u0438\u0448\u043B\u0438 \u0441\u043B\u043E\u0432\u0430 \u043E\u0434\u043D\u043E\u0439
    \u0434\u0430\u043C\u044B, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0430
    \u043A\u043E \u043C\u043D\u0435 \u0441 \u0441\u0430\u043F\u0444\u0438\u0440\u043E\u0432\u044B\u043C
    \u043A\u043E\u043B\u044C\u0435. \u041E\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
    \u0447\u0442\u043E \u0435\u0439 \u043E\u043D\u043E \u0434\u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
    \u043F\u043E \u043D\u0430\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0443. \u0410
    \u044F \u0435\u0449\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B, \u0447\u0442\u043E
    \u0442\u043E\u0442 \u0441\u0430\u043F\u0444\u0438\u0440 \u0431\u044B\u043B \u043D\u0435\u0437\u0430\u0443\u0440\u044F\u0434\u043D\u043E\u0433\u043E
    \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430."
