      m_Calls: []
  m_text: "1. \u0412 \u0446\u0435\u043D\u0442\u0440\u0435 \u043F\u043E\u043B\u044F
    4 \u0441\u0438\u043D\u0438\u0435 \u043F\u043B\u0438\u0442\u043A\u0438 <u>\u043D\u0430\u043A\u043E\u0432\u0430\u043B\u044C\u043D\u0438</u>.
    \u0427\u0442\u043E\u0431\u044B \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043F\u043B\u0438\u0442\u043A\u0443, \u043D\u0430\u0434 \u043D\u0435\u0439 \u043D\u0443\u0436\u043D\u043E
