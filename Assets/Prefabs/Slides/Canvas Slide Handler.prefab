  m_text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!
    \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430 \u0432\u0430\u0448\u0430 \u043F\u043E\u043C\u043E\u0449\u044C.
    \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0447\u0442\u043E \u0438\u0437 \u0432\u0441\u0435\u0445
    \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u0432 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u0443 \u0432\u0430\u0441 \u0432\u0441\u0435
    \u0435\u0449\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442\u0441\u044F
    \u0441\u0438\u044F\u044E\u0449\u0438\u0435 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u044F.
    \u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0444\u0430\u043C\u0438\u043B\u044C\u043D\u043E\u0435
    \u043A\u043E\u043B\u044C\u0435, \u0438 \u043E\u043D\u043E \u043F\u043E\u0442\u0443\u0441\u043A\u043D\u0435\u043B\u043E.
    \u0412\u044B \u043D\u0435 \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C
    \u0435\u043C\u0443 \u043F\u0440\u0435\u0436\u043D\u0438\u0439 \u0432\u0438\u0434?"
