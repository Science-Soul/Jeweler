  m_text: "\u042D\u0442\u043E\u0442 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442
    \u0431\u044B\u043B \u043F\u0440\u0438\u0437\u0432\u0430\u043D \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C
    \u0441\u0432\u0435\u0442 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438. \u0421 \u0435\u0433\u043E
    \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0414\u0440\u0435\u0432\u043D\u0438\u0435
    \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C \u0432 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435
    \u043F\u043E \u0412\u0441\u0435\u043B\u0435\u043D\u043D\u043E\u0439 \u0432 \u043F\u043E\u0438\u0441\u043A\u0430\u0445
    \u043D\u043E\u0432\u044B\u0445 \u0437\u043D\u0430\u043D\u0438\u0439."
